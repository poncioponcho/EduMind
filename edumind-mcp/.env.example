# EduMind MCP Super Teacher 环境配置
# 复制此文件为 .env 并填入你的API Key

# === LLM提供商配置（至少配置一个）===

# Google Gemini (推荐，免费额度大)
GOOGLE_API_KEY=

# 阿里云百炼/通义千问 (国内推荐)
DASHSCOPE_API_KEY=

# Kimi Code/Moonshot
MOONSHOT_API_KEY=

# OpenAI GPT
OPENAI_API_KEY=

# === 可选配置 ===

# 强制指定LLM提供商（留空则自动检测）
# 可选值: gemini, qwen, kimi, openai
LLM_PROVIDER=

# 模型名称（留空使用默认值）
# GEMINI_MODEL=gemini-2.0-flash
# QWEN_MODEL=qwen-plus
# KIMI_MODEL=moonshot-v1-auto
# OPENAI_MODEL=gpt-4o-mini

# LLM温度（0.0-1.0，越高越有创造性）
# LLM_TEMPERATURE=0.7

# 服务端口
# MCP_PORT=8000

# CORS允许的源（逗号分隔）
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
