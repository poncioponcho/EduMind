# EduMind A2A Team 环境配置
# 复制此文件为 .env 并填入实际值

# LLM API Key（至少配置一个）
# Gemini
# GOOGLE_API_KEY=your_google_api_key

# 阿里云百炼（通义千问）
# DASHSCOPE_API_KEY=your_dashscope_api_key

# Kimi Code（Moonshot）
# MOONSHOT_API_KEY=your_moonshot_api_key

# OpenAI
# OPENAI_API_KEY=your_openai_api_key

# A2A 服务端口
A2A_PORT=8001

# 数据存储目录
# DATA_DIR=./data

# 日志级别
LOG_LEVEL=INFO
