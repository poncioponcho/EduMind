# EduMind 环境变量配置
# 复制此文件为 .env 后填写实际值

# === LLM API Keys（至少配置一个）===
# 阿里云百炼（推荐，Qwen系列模型）
DASHSCOPE_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# OpenAI / DeepSeek
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Kimi Code（月之暗面）
MOONSHOT_API_KEY=

# === LLM 提供商选择 ===
# 可选值: qwen, gemini, openai, kimi, deepseek
# 留空则自动检测（根据已配置的API Key）
LLM_PROVIDER=

# === 服务端口 ===
MCP_PORT=8000
COGNITIVE_PORT=8002
EVOLVE_PORT=8003

# === CORS 跨域 ===
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# === 注意事项 ===
# MCP 协议需要本地文件系统和命令行访问，在线部署无法支持完整 MCP 功能。
# 部署到 Render/Vercel 等平台时，仅 API 服务可用，MCP 工具调用受限。
