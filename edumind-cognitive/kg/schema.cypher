CREATE CONSTRAINT concept_name IF NOT EXISTS FOR (c:Concept) REQUIRE c.name IS UNIQUE;
CREATE CONSTRAINT student_id IF NOT EXISTS FOR (s:Student) REQUIRE s.id IS UNIQUE;
CREATE CONSTRAINT misconception_name IF NOT EXISTS FOR (m:Misconception) REQUIRE m.name IS UNIQUE;

CREATE (c1:Concept {name: "一元一次方程", subject: "数学", grade: "初一", difficulty: 0.3})
CREATE (c2:Concept {name: "一元二次方程", subject: "数学", grade: "初三", difficulty: 0.5})
CREATE (c3:Concept {name: "二次函数", subject: "数学", grade: "初三", difficulty: 0.6})
CREATE (c4:Concept {name: "函数图像变换", subject: "数学", grade: "初三", difficulty: 0.65})
