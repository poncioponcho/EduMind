CREATE (c6:Concept {name: "绝对值", subject: "数学", grade: "初一", difficulty: 0.25})
CREATE (c7:Concept {name: "因式分解", subject: "数学", grade: "初二", difficulty: 0.45})
CREATE (c8:Concept {name: "配方法", subject: "数学", grade: "初三", difficulty: 0.55})
CREATE (c9:Concept {name: "判别式", subject: "数学", grade: "初三", difficulty: 0.5})
CREATE (c10:Concept {name: "韦达定理", subject: "数学", grade: "初三", difficulty: 0.6})
CREATE (c11:Concept {name: "极限", subject: "数学", grade: "高三", difficulty: 0.75})
CREATE (c12:Concept {name: "导数", subject: "数学", grade: "高三", difficulty: 0.8})
CREATE (c13:Concept {name: "定积分", subject: "数学", grade: "高三", difficulty: 0.85})
CREATE (c14:Concept {name: "不定积分", subject: "数学", grade: "高三", difficulty: 0.85})
CREATE (c15:Concept {name: "微积分基本定理", subject: "数学", grade: "高三", difficulty: 0.9})

CREATE (c7)-[:HAS_PREREQUISITE]->(c2)
