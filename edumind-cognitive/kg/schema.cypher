CREATE (m1:Misconception {name: "混淆顶点式与一般式", freq: 0.35, root: "配方法掌握不足"})
CREATE (m2:Misconception {name: "开口方向判断错误", freq: 0.25, root: "系数正负理解偏差"})
CREATE (m3:Misconception {name: "求根公式记忆错误", freq: 0.30, root: "公式推导过程不熟"})
CREATE (m4:Misconception {name: "忽略判别式判断", freq: 0.40, root: "实数根条件理解缺失"})
CREATE (m5:Misconception {name: "符号混淆", freq: 0.45, root: "推导过程不熟练"})
CREATE (m6:Misconception {name: "混淆极限不存在与无穷大", freq: 0.35, root: "极限定义理解不足"})
CREATE (m7:Misconception {name: "链式法则应用错误", freq: 0.40, root: "复合函数分解能力弱"})
CREATE (m8:Misconception {name: "混淆导数与原函数关系", freq: 0.30, root: "导数几何意义理解不足"})
CREATE (m9:Misconception {name: "遗漏积分常数C", freq: 0.50, root: "不定积分概念理解偏差"})
CREATE (m10:Misconception {name: "上下限代入错误", freq: 0.35, root: "牛顿莱布尼茨公式不熟"})
CREATE (m11:Misconception {name: "十字相乘法符号错误", freq: 0.35, root: "符号运算粗心"})
CREATE (m12:Misconception {name: "配方步骤遗漏", freq: 0.40, root: "完全平方公式不熟"})

